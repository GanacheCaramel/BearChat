<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_latte"
    android:padding="16dp">
	
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">
		
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="16dp">
			
			<!-- Logo et Titre -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center"
				android:layout_marginBottom="32dp"
				android:layout_marginTop="20dp">
				<ImageView
					android:id="@+id/logo"
					android:layout_width="60dp"
					android:layout_height="60dp"
					android:src="@drawable/ic_logo"
					android:tint="@color/caramel"
					android:layout_marginEnd="16dp"/>
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Bear"
					android:textSize="32sp"
					android:textColor="@color/cafe_noir"
					android:textStyle="bold"
					android:letterSpacing="0.02"/>
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Chat"
					android:textSize="32sp"
					android:textColor="@color/accent_caramel"
					android:textStyle="bold"
					android:letterSpacing="0.02"/>
			</LinearLayout>
			
			<!-- Sous-titre -->
			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Connexion à votre compte"
				android:textSize="20sp"
				android:textColor="@color/caramel"
				android:gravity="center"
				android:layout_marginBottom="40dp"/>
			
			<!-- Card du formulaire -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:background="@drawable/card_background"
				android:padding="24dp"
				android:elevation="4dp"
				android:layout_marginBottom="18dp">
				<include layout="@layout/block_pseudo_nyme"/>
				<include layout="@layout/number_phone"/>
				
				<!-- Bouton de connexion -->
				<Button
					android:id="@+id/next_button"
					android:layout_width="match_parent"
					android:layout_height="56dp"
					android:text="SUIVANT"
					android:textStyle="bold"
					android:textSize="20sp"
					android:background="@drawable/button_background"
					android:textColor="@android:color/white"
					android:layout_marginTop="8dp"/>
			</LinearLayout>
		</LinearLayout>
    </ScrollView>
</RelativeLayout>
