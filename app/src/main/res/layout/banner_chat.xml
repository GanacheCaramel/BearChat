<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/chat_banner_normal"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@android:color/transparent">
	<ImageButton
		android:id="@+id/chat_btn_back"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="start|center_vertical"
		android:layout_marginLeft="1dp"
		android:background="@android:color/transparent"
		android:src="@drawable/ic_back_arrow"
		android:tint="@color/chocolate_dark" />

	<ImageButton
		android:id="@+id/chat_pic"
		android:layout_width="50dp"
		android:layout_height="50dp"
		android:layout_gravity="start|center_vertical"
		android:layout_marginLeft="3dp"
		android:layout_marginRight="4dp"
		android:background="@android:color/transparent"
		android:src="@drawable/ic_launcher"
		android:tint="?android:attr/textColorPrimary" />

	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:orientation="vertical"
		android:layout_gravity="start|center_vertical">
		<TextView
			android:id="@+id/chat_name"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="5dp"
			android:text="Nom du contact"
			android:textColor="@color/chocolate_dark"
			android:textSize="18sp"
			android:textStyle="bold" />

		<TextView
			android:id="@+id/chat_contact_time"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="5dp"
			android:layout_marginTop="1dp"
			android:text="last seen recently"
			android:textColor="@color/chocolate_dark"
			android:textSize="14sp"/>
	</LinearLayout>

	<ImageButton
		android:id="@+id/chat_call"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:layout_gravity="end|center_vertical"
		android:layout_marginRight="8dp"
		android:background="?android:attr/selectableItemBackgroundBorderless"
		android:src="@drawable/ic_phone"
		android:tint="@color/chocolate_dark" />

	<ImageButton
		android:id="@+id/chat_menu"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:src="@drawable/ic_menu"
		android:background="?android:attr/selectableItemBackgroundBorderless"
		android:scaleType="centerCrop"
		android:tint="@color/chocolate_dark"
		android:layout_marginRight="4dp"
		android:layout_gravity="end|center_vertical"/>
</LinearLayout>
