<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:padding="0dp">
	
	
	<LinearLayout
		android:id="@+id/sent_card_msg"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_alignParentRight="true"
		android:background="@drawable/bubble_sent"
		android:orientation="vertical"
		android:padding="6dp"
		android:layout_gravity="end"
		android:layout_margin="10dp"
		android:layout_marginBottom="5dp">
		<LinearLayout
			android:id="@+id/sent_reply_indicator"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginBottom="8dp"
			android:background="@drawable/bubble_sent_reply"
			android:visibility="gone">
			<View
				android:layout_width="8dp"
				android:layout_height="match_parent"
				android:layout_marginLeft="3dp"
				android:background="@drawable/bar_sent_reply_bg"/>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="10dp"
				android:orientation="vertical">
				<TextView
					android:id="@+id/sent_message_title_reply"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="?android:attr/textColorSecondary"
					android:textSize="16sp" 
					android:textStyle="bold" 
					android:text="Reply to"
					android:layout_marginBottom="8dp"/>
				<TextView
					android:id="@+id/sent_message_content_reply"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="?android:attr/textColorSecondary"
					android:textSize="16sp"
					android:text="Here is the content..."/>
			</LinearLayout>
		</LinearLayout>
		
		<TextView
			android:id="@+id/sent_message_content"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/chocolate_medium"
			android:textSize="16sp"
			android:layout_margin="6dp"/>
		
		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="end"
			android:layout_marginRight="8dp"
			android:layout_marginLeft="8dp"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/sent_message_time"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:textColor="#aaffffff"
				android:layout_marginRight="8dp"
				android:textSize="12sp" />
			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:layout_gravity="center_vertical"
				android:visibility="visible">
				<ImageView
					android:id="@+id/sent_message_check0"
					android:layout_width="15dp"
					android:layout_height="15dp"
					android:src="@drawable/ic_times"
					android:tint="@color/chocolate_light"
					android:layout_gravity="center_vertical"
					android:visibility="visible"/>
				<ImageView
					android:id="@+id/sent_message_check1"
					android:layout_width="12dp"
					android:layout_height="12dp"
					android:src="@drawable/ic_check"
					android:tint="@color/chocolate_light"
					android:layout_gravity="center_vertical"
					android:visibility="gone"/>
				<ImageView
					android:id="@+id/sent_message_check2"
					android:layout_width="12dp"
					android:layout_height="12dp"
					android:src="@drawable/ic_check"
					android:tint="@color/chocolate_light"
					android:layout_gravity="center_vertical"
					android:visibility="gone"/>
			</LinearLayout>
		</LinearLayout>
		
	</LinearLayout>
</FrameLayout>