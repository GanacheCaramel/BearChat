<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:padding="0dp">
	
	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_alignParentRight="true"
		android:background="@drawable/bubble_received"
		android:orientation="vertical"
		android:padding="8dp"
		android:layout_gravity="start"
		android:layout_margin="5dp">
		
		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginBottom="6dp"
			android:background="@drawable/bubble_received_reply"
			android:visibility="gone">
			<View
				android:layout_width="8dp"
				android:layout_height="match_parent"
				android:layout_marginLeft="3dp"
				android:background="@drawable/bar_received_reply_bg"/>
			
			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="12dp"
				android:orientation="vertical"
				android:layout_margin="5dp">
				<TextView
					android:id="@+id/received_message_title_replied"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="?android:attr/textColorSecondary"
					android:textSize="16sp" 
					android:text="Reply to"
					android:layout_marginBottom="6dp"/>

				<TextView
					android:id="@+id/received_message_content_replied"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="?android:attr/textColorSecondary"
					android:textSize="16sp"
					android:text="Here is the content..."/>
			</LinearLayout>
		</LinearLayout>
		
	<TextView
		android:id="@+id/received_message_content"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:textColor="?android:attr/textColorSecondary"
		android:textSize="16sp"
		android:text="Hello Tadashi, how's up ??"
		android:layout_margin="6dp"/>
	
	<TextView
		android:id="@+id/received_message_time"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="end"
		android:textColor="#000000"
		android:textSize="12sp"
		android:text="12:33"
		android:layout_marginRight="8dp"/>
	</LinearLayout>
</FrameLayout>
