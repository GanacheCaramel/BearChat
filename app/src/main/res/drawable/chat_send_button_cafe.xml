<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <item android:id="@+id/pressed" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/chocolate_light" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    
    <item android:id="@+id/normal">
        <shape android:shape="rectangle">
            <solid android:color="@color/chocolate_medium" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    
    <!-- Transitions -->
    <transition
        android:fromId="@+id/normal"
        android:toId="@+id/pressed">
        <animation-list>
            <item android:duration="50">
                <shape android:shape="rectangle">
                    <solid android:color="@color/chocolate_medium" />
                    <corners android:radius="8.5dp" />
                </shape>
            </item>
            <item android:duration="50">
                <shape android:shape="rectangle">
                    <solid android:color="@color/chocolate_dark" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
            <item android:duration="50">
                <shape android:shape="rectangle">
                    <solid android:color="@color/chocolate_dark" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:duration="50">
                <shape android:shape="rectangle">
                    <solid android:color="@color/chocolate_dark" />
                    <corners android:radius="11dp" />
                </shape>
            </item>
            <item android:duration="50">
                <shape android:shape="rectangle">
                    <solid android:color="@color/chocolate_light" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:duration="50">
                <shape android:shape="rectangle">
                    <solid android:color="@color/chocolate_dark" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:duration="50">
                <shape android:shape="rectangle">
                    <solid android:color="@color/chocolate_dark" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </animation-list>
    </transition>
    
    <transition
        android:fromId="@+id/pressed"
        android:toId="@+id/normal">
        <animation-list>
            <item android:duration="50">
                <shape android:shape="rectangle">
                    <solid android:color="@color/chocolate_light" />
                    <corners android:radius="14.5dp" />
                </shape>
            </item>
            <item android:duration="50">
                <shape android:shape="rectangle">
                    <solid android:color="@color/chocolate_dark" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:duration="50">
                <shape android:shape="rectangle">
                    <solid android:color="@color/chocolate_dark" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:duration="50">
                <shape android:shape="rectangle">
                    <solid android:color="@color/chocolate_dark" />
                    <corners android:radius="11dp" />
                </shape>
            </item>
            <item android:duration="50">
                <shape android:shape="rectangle">
                    <solid android:color="@color/chocolate_dark" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:duration="50">
                <shape android:shape="rectangle">
                    <solid android:color="@color/chocolate_dark" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
            <item android:duration="50">
                <shape android:shape="rectangle">
                    <solid android:color="@color/chocolate_medium" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </animation-list>
    </transition>
    
</animated-selector>
